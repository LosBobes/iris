# Copy to .env next to docker-compose.yml on the Windows Server (README,
# "Configure .env"). Never commit the real .env; it holds the database password.

IRIS_ENV=production

# PostgreSQL (recommended; required to move the Hetzner database over).
# Generate the password with the PowerShell one-liner in the README and use the
# SAME value in both lines. Hex only, so it needs no escaping in the URL.
COMPOSE_PROFILES=postgres
POSTGRES_PASSWORD=<hex-password>
DATABASE_URL=postgres://iris:<hex-password>@db:5432/iris?sslmode=disable

# The LAN uses plain http://<server>/; browsers drop Secure cookies on http,
# so sign-in fails without this. Remove it if the stack is served over HTTPS.
IRIS_SECURE_COOKIES=false
