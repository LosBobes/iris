# Iris vhost for the shared Hetzner host.
#
# Caddy runs on the host and already serves gamgee. Do NOT overwrite the
# server's /etc/caddy/Caddyfile with this file — APPEND this block to it so
# gamgee's existing block is left untouched. See docs/deployment-hetzner.md.
#
# Caddy automatically obtains and renews a Let's Encrypt TLS certificate for
# this domain.

iris-application.com {
    # Compress responses to the browser. nginx already gzips inside the stack;
    # Caddy passes an already-encoded response through untouched, so this
    # mainly covers anything nginx does not compress itself.
    encode zstd gzip

    reverse_proxy localhost:3001 {
        # Absorb the few seconds when compose is recreating the containers
        # during a deploy. Without this, every request in that window is a
        # hard 502 — which is what an operator sees as "the page didn't load,
        # but it works if I refresh".
        #
        # Deliberately shorter than a request timeout anyone monitors this
        # domain with (Sentry's uptime check gives up at 10s). Retrying for
        # that long turns a real outage into a request that just hangs: the
        # monitor reports "timeout, no status code", which says nothing about
        # what broke, and a visitor watches a blank tab. Below that ceiling
        # the window has to clear an actual recreate: deploy run 35 took 5.9s
        # from "frontend recreated" to "frontend started", nearly all of it
        # waiting on the backend's health gate (see docker-compose.prod.yml).
        # Seven seconds covers that with room to spare and still leaves the
        # monitor ~3s to receive the 502 an outage deserves to be.
        lb_try_duration 7s
        lb_try_interval 500ms
    }
}
