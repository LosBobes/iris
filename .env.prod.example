# Production environment for the Hetzner deploy (docker-compose.prod.yml).
#
# Copy to `.env` on the server (next to docker-compose.prod.yml) and fill in
# real values. This file is gitignored on the server; never commit the real
# secrets.

# Marks the backend as running in production (secure cookies, etc.).
IRIS_ENV=production

# IRIS_SESSION_SECRET is no longer used or required: session tokens are
# random and stored hashed, so nothing is signed. An existing value is
# harmless and ignored.

# Same-origin deploy (browser -> Caddy -> nginx -> /api/), so this stays empty.
# Only set it if you serve the API on a different origin.
IRIS_ALLOWED_ORIGINS=

# Optional release identifier tagged onto Sentry events (e.g. the git sha).
IRIS_RELEASE=

# Passwords for the optional demo organization (/login/demo), used by
# `irisctl seed-demo` run inside the backend container. The demo org is created
# only when you run seed-demo (never on start). In production both are REQUIRED
# to seed it (12+ characters, and not the public demo passwords) — otherwise the
# backend would refuse to start on the demo admin/admin123 login.
#   openssl rand -base64 18
# IRIS_DEMO_ADMIN_PASSWORD=
# IRIS_DEMO_OPERATOR_PASSWORD=
# Set a prefix for the demo fixture record ids when this database already holds
# another tenant seeded from the same fixed ids (customers cust-N, work orders
# 1…), such as the real Grafika Čobanović data — otherwise seed-demo collides.
# IRIS_DEMO_ID_PREFIX=demo-

# Release to run. The deploy workflow sets this per deploy (git-<sha7>); a
# value here is the fallback for manual `docker compose` runs on the server.
# Pin an older git-<sha7> to roll back.
# Manual `docker compose` commands on the server MUST export the tag that is
# actually running (the local :latest is stale), e.g.
#   export IRIS_IMAGE_TAG="$(docker inspect --format '{{.Config.Image}}' "$(docker compose -f docker-compose.prod.yml ps -q backend)" | sed 's/.*://')"
# and it must print git-<sha7>. See deploy/POSTGRES.md step 0.
IRIS_IMAGE_TAG=latest

# Connection-pool size for SQLite. Defaults to 8 when unset; readers run
# concurrently under WAL, writes still serialize inside SQLite.
# IRIS_DB_MAX_OPEN_CONNS=8

# PostgreSQL (optional; SQLite is used while DATABASE_URL is empty). The cutover
# procedure is deploy/POSTGRES.md; do not set these ad hoc. COMPOSE_PROFILES
# turns the `db` service on, POSTGRES_PASSWORD is its first-initialisation
# password (use hex: `openssl rand -hex 24`, URL-safe for DATABASE_URL), and
# DATABASE_URL switches the API to it ONLY after the data has been copied.
# Never `source` this file: it would reset IRIS_IMAGE_TAG.
# COMPOSE_PROFILES=postgres
# POSTGRES_DB=iris
# POSTGRES_USER=iris
# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://iris:<POSTGRES_PASSWORD>@db:5432/iris?sslmode=disable
