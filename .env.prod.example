# Production environment for the Hetzner deploy (docker-compose.prod.yml).
#
# Copy to `.env` on the server (next to docker-compose.prod.yml) and fill in
# real values. This file is gitignored on the server; never commit the real
# secrets.

# Marks the backend as running in production (secure cookies, etc.).
IRIS_ENV=production

# Session cookie signing secret. REQUIRED — the backend refuses to start
# without it. Generate a long random value:
#   openssl rand -hex 32
IRIS_SESSION_SECRET=

# Same-origin deploy (browser -> Caddy -> nginx -> /api/), so this stays empty.
# Only set it if you serve the API on a different origin.
IRIS_ALLOWED_ORIGINS=

# Optional release identifier tagged onto Sentry events (e.g. the git sha).
IRIS_RELEASE=

# Optional showcase organization (/login/showcase) with sample processes and
# warehouse stock, for trying the Procesi rada and Magacin modules. With
# IRIS_SEED_SHOWCASE=1 the backend creates it once, on the first start that
# finds it missing; leaving the flag on afterwards is harmless. It is a
# separate organization and never touches other organizations' data.
# Both passwords are REQUIRED for it in production (12+ characters, not the
# demo ones); without them the backend skips the seed and logs a warning.
#   openssl rand -base64 18
# IRIS_SEED_SHOWCASE=1
# IRIS_SHOWCASE_ADMIN_PASSWORD=
# IRIS_SHOWCASE_OPERATOR_PASSWORD=

# Release to run. The deploy workflow sets this per deploy (git-<sha7>); a
# value here is the fallback for manual `docker compose` runs on the server.
# Pin an older git-<sha7> to roll back.
IRIS_IMAGE_TAG=latest

# Connection-pool size for SQLite. Defaults to 8 when unset; readers run
# concurrently under WAL, writes still serialize inside SQLite.
# IRIS_DB_MAX_OPEN_CONNS=8
